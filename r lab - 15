data(iris)

print(dim(iris))

print(summary(iris))

print(sd(iris$Sepal.Length))
print(sd(iris$Sepal.Width))
print(sd(iris$Petal.Length))
print(sd(iris$Petal.Width))

print(quantile(iris$Sepal.Length))
print(quantile(iris$Sepal.Width))
print(quantile(iris$Petal.Length))
print(quantile(iris$Petal.Width))

grouped_data <- aggregate(
  cbind(Sepal.Length, Sepal.Width, Petal.Length, Petal.Width) ~ Species,
  data = iris,
  FUN = mean
)

print(grouped_data)

pivot_table <- xtabs(Sepal.Length ~ Species, data = iris)

print(pivot_table)

iris$Sepal_Length_Category <- cut(
  iris$Sepal.Length,
  breaks = c(4, 5, 6, 7, 8),
  labels = c("Low", "Medium", "High", "Very High")
)

print(iris)

categorical_grouping <- aggregate(
  Sepal.Length ~ Sepal_Length_Category,
  data = iris,
  FUN = mean
)

print(categorical_grouping)
