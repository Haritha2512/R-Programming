data(ChickWeight)

model <- lm(weight ~ Time + Diet, data = ChickWeight)

print(summary(model))

predicted_weight <- predict(model)

print(predicted_weight)

actual_weight <- ChickWeight$weight

error <- actual_weight - predicted_weight

print(error)

mse <- mean(error^2)

print(mse)

rmse <- sqrt(mse)

print(rmse)
