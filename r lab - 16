data(USArrests)

print(summary(USArrests))

print(mean(USArrests$Murder))
print(mean(USArrests$Assault))
print(mean(USArrests$UrbanPop))
print(mean(USArrests$Rape))

largest_rape <- rownames(USArrests)[which.max(USArrests$Rape)]
print(largest_rape)
print(max(USArrests$Rape))

max_murder <- rownames(USArrests)[which.max(USArrests$Murder)]
min_murder <- rownames(USArrests)[which.min(USArrests$Murder)]

print(max_murder)
print(USArrests[max_murder, "Murder"])

print(min_murder)
print(USArrests[min_murder, "Murder"])

correlation <- cor(USArrests)
print(correlation)

median_assault <- median(USArrests$Assault)
above_median_assault <- USArrests[USArrests$Assault > median_assault, ]

print(above_median_assault)

murder_25 <- quantile(USArrests$Murder, 0.25)
bottom_25_murder <- USArrests[USArrests$Murder <= murder_25, ]

print(bottom_25_murder)

hist(USArrests$Murder,
     main = "Histogram of Murder Arrests",
     xlab = "Murder Arrests")

plot(density(USArrests$Murder),
     main = "Density Plot of Murder Arrests",
     xlab = "Murder Arrests")

plot(USArrests$Assault, USArrests$Murder,
     main = "Assault vs Murder",
     xlab = "Assault Arrests",
     ylab = "Murder Arrests")

barplot(USArrests$Murder,
        names.arg = rownames(USArrests),
        main = "Murder Arrests by State",
        xlab = "State",
        ylab = "Murder Arrests",
        las = 2)
